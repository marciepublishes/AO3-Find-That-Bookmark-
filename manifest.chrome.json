{
  "manifest_version": 3,
  "name": "AO3 Find That Bookmark! (Deleted Works)",
  "version": "1.3.0",
  "description": "Flags which of your Archive of Our Own bookmarks have been deleted, right on your bookmarks page.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://archiveofourown.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AO3 Lost and Found",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://archiveofourown.org/users/*"
      ],
      "js": [
        "modules/constants.js",
        "modules/bookmark-parser.js",
        "modules/injection-manager.js",
        "bookmarks-injector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
