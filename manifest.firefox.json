{
  "manifest_version": 3,
  "name": "AO3 Find That Bookmark! (Deleted Works)",
  "version": "1.5.0",
  "description": "Tracks AO3 bookmarks locally and shows which bookmarked works have been deleted in a private, separate view.",
  "permissions": [
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://archiveofourown.org/*"
  ],
  "background": {
    "scripts": [
      "lib/dexie.min.js",
      "modules/constants.js",
      "modules/db.js",
      "modules/bookmark-parser.js",
      "modules/import-manager.js",
      "modules/check-manager.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AO3 Lost and Found",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://archiveofourown.org/users/*"
      ],
      "js": [
        "modules/constants.js",
        "modules/bookmark-parser.js",
        "modules/injection-manager.js",
        "bookmarks-injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{dcfd75d3-ed69-4d6a-94dc-b16468cfb96d}",
      "strict_min_version": "109.0"
    }
  }
}
